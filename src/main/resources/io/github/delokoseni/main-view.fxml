<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.delokoseni.controller.MainController"
            styleClass="root">

    <!-- Верхняя часть -->
    <top>
        <VBox alignment="CENTER" spacing="8">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="МОДЕЛИРОВАНИЕ РАБОТЫ"
                   styleClass="main-title"/>

            <Label text="ОПЕРАЦИОННОЙ СИСТЕМЫ"
                   styleClass="main-title"/>

            <Label text="В ПАКЕТНОМ РЕЖИМЕ"
                   styleClass="main-title"/>

            <Label text="С ИСПОЛЬЗОВАНИЕМ ПРИНЦИПА КЛАССИЧЕСКОГО МУЛЬТИПРОГРАММИРОВАНИЯ"
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="15"
                  vgap="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="65"/>
                <ColumnConstraints percentWidth="35"/>
            </columnConstraints>

            <!-- Левая часть -->
            <VBox spacing="10"
                  GridPane.columnIndex="0">

                <Label text="Журнал выполнения"
                       styleClass="section-title"/>

                <TextArea fx:id="outputArea"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"
                          promptText="Здесь будет отображаться ход моделирования..."/>

                <!-- Заглушки графиков -->
                <GridPane hgap="10"
                          vgap="10"
                          VBox.vgrow="NEVER">

                    <Label text="График 1"
                           styleClass="graph-placeholder"
                           GridPane.columnIndex="0"/>

                    <Label text="График 2"
                           styleClass="graph-placeholder"
                           GridPane.columnIndex="1"/>

                    <Label text="График 3"
                           styleClass="graph-placeholder"
                           GridPane.columnIndex="2"/>

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="34"/>
                    </columnConstraints>

                </GridPane>

            </VBox>

            <!-- Правая часть -->
            <VBox spacing="15"
                  GridPane.columnIndex="1">

                <Label text="Параметры системы"
                       styleClass="section-title"/>

                <!-- Количество разделов -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="Максимальное количество разделов"
                           HBox.hgrow="ALWAYS"/>

                    <Spinner fx:id="blocksSpinner"
                             prefWidth="90"/>
                </HBox>

                <!-- Количество тактов -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="Максимальное количество тактов"
                           HBox.hgrow="ALWAYS"/>

                    <Spinner fx:id="tactsSpinner"
                             prefWidth="90"/>
                </HBox>

                <!-- RAM -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="RAM (ОП) в ГБ"
                           HBox.hgrow="ALWAYS"/>

                    <Spinner fx:id="ramSpinner"
                             prefWidth="90"/>
                </HBox>

                <Separator/>

                <Label text="Текущий пакет:"
                       styleClass="label-title"/>

                <TextField fx:id="packageNameField"
                           editable="false"/>

                <HBox spacing="10">

                    <Button text="Выбрать другой пакет"
                            onAction="#choosePackage"
                            HBox.hgrow="ALWAYS"/>

                    <Button text="Создать новый пакет"
                            onAction="#createPackage"
                            HBox.hgrow="ALWAYS"/>
                </HBox>

                <Separator/>

                <HBox spacing="10">
                    <Label text="Тип пакета:"
                           styleClass="label-title"/>

                    <Label fx:id="packageTypeLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="CPU-bound задач:"
                           styleClass="label-title"/>

                    <Label fx:id="cpuTaskCountLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="I/O-bound задач:"
                           styleClass="label-title"/>

                    <Label fx:id="ioTaskCountLabel"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="СТАРТ СИМУЛЯЦИИ"
                        onAction="#startSimulation"
                        styleClass="start-button"
                        maxWidth="Infinity"/>

                <Label text="Для выхода из программы нажмите ESC"
                       styleClass="hint"
                       wrapText="true"/>

            </VBox>

        </GridPane>
    </center>

</BorderPane>