<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.delokoseni.controller.MainController"
            styleClass="root">

    <center>
        <GridPane hgap="15"
                  vgap="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="65"/>
                <ColumnConstraints percentWidth="35"/>
            </columnConstraints>

            <!-- Левая часть -->
            <VBox spacing="10"
                  GridPane.columnIndex="0">

                <Label text="Журнал выполнения"
                       styleClass="section-title"/>

                <TextArea fx:id="outputArea"
                          editable="false"
                          wrapText="true"
                          minHeight="320"
                          prefHeight="320"
                          VBox.vgrow="NEVER"
                          promptText="Здесь будет отображаться ход моделирования..."/>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            minHeight="0"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <GridPane hgap="10"
                                  vgap="10"
                                  prefHeight="1020"
                                  minHeight="950">

                            <StackPane fx:id="ganttChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <StackPane fx:id="cpuChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <StackPane fx:id="ioChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <StackPane fx:id="memoryChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <StackPane fx:id="completionChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <StackPane fx:id="turnaroundChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <StackPane fx:id="ratioChartSlot"
                                       styleClass="chart-slot"
                                       GridPane.columnIndex="0"
                                       GridPane.columnSpan="2"
                                       GridPane.rowIndex="3"
                                       GridPane.hgrow="ALWAYS"
                                       GridPane.vgrow="ALWAYS"
                                       minHeight="230"
                                       maxWidth="Infinity"
                                       maxHeight="Infinity"/>

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints percentHeight="25"/>
                                <RowConstraints percentHeight="25"/>
                                <RowConstraints percentHeight="25"/>
                                <RowConstraints percentHeight="25"/>
                            </rowConstraints>
                        </GridPane>
                    </content>
                </ScrollPane>

            </VBox>

            <!-- Правая часть -->
            <VBox spacing="15"
                  GridPane.columnIndex="1">

                <Label text="Параметры системы"
                       styleClass="section-title"/>

                <!-- Количество разделов -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="Максимальное количество разделов"
                           HBox.hgrow="ALWAYS"/>

                    <Spinner fx:id="blocksSpinner"
                             prefWidth="90"/>
                </HBox>

                <!-- Количество тактов -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="Максимальное количество тактов"
                           HBox.hgrow="ALWAYS"/>

                    <Spinner fx:id="tactsSpinner"
                             prefWidth="90"/>
                </HBox>

                <!-- RAM -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="RAM (ОП) в ГБ"
                           HBox.hgrow="ALWAYS"/>

                    <Spinner fx:id="ramSpinner"
                             prefWidth="90"/>
                </HBox>

                <Separator/>

                <Label text="Текущий пакет:"
                       styleClass="label-title"/>

                <TextField fx:id="packageNameField"
                           editable="false"/>

                <HBox spacing="10">

                    <Button text="Выбрать другой пакет"
                            onAction="#choosePackage"
                            HBox.hgrow="ALWAYS"/>

                    <Button text="Создать новый пакет"
                            onAction="#createPackage"
                            HBox.hgrow="ALWAYS"/>
                </HBox>

                <Separator/>

                <HBox spacing="10">
                    <Label text="Тип пакета:"
                           styleClass="label-title"/>

                    <Label fx:id="packageTypeLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="CPU-bound задач:"
                           styleClass="label-title"/>

                    <Label fx:id="cpuTaskCountLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="I/O-bound задач:"
                           styleClass="label-title"/>

                    <Label fx:id="ioTaskCountLabel"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="СТАРТ СИМУЛЯЦИИ"
                        onAction="#startSimulation"
                        styleClass="start-button"
                        maxWidth="Infinity"/>

            </VBox>

        </GridPane>
    </center>

</BorderPane>